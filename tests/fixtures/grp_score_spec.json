  "purpose": "Score one measure group per hospital: average the hospital's available standardized measures, then standardize that average across hospitals.",
  "contract": {
    "function": "grp_score",
    "inputs": [
      {
        "name": "indsn",
        "type": "DataFrame",
        "key": "PROVIDER_ID",
        "requires": [
          "PROVIDER_ID",
          "*varlist"
        ]
      },
      {
        "name": "varlist",
        "type": "list[str]",
        "requires": []
      }
    ],
    "returns": [
      {
        "name": "Out_avg",
        "columns": [
          "PROVIDER_ID",
          "*varlist",
          "C1..Cn",
          "total_cnt",
          "measure_wt",
          "score_before_std",
          "Mean",
          "StdDev",
          "grp_score"
        ],
        "rows": "one per row of indsn, same order, including hospitals with no measures"
      }
    ],
    "omitted_params": [
      {
        "param": "gp",
        "reason": "unused"
      },
      {
        "param": "nmeasure",
        "reason": "equals len(varlist)"
      }
    ]
  },
  "logic": [
    {
      "step": "s1",
      "risks": [
        "S-02"
      ],
      "text": "Ck = 1 if measure k is non-missing else 0. total_cnt = sum of Ck. If total_cnt > 0: measure_wt = 1/total_cnt and avg = (sum of non-missing measures) x measure_wt. Otherwise measure_wt and avg are missing."
    },
    {
      "step": "s2",
      "risks": [
        "S-01"
      ],
      "text": "grp_score = (avg - mean) / SD, computed over non-missing avg, SD divisor N-1. Missing avg stays missing."
    },
    {
      "step": "s3",
      "risks": [
        "S-01",
        "S-09"
      ],
      "text": "One row: Mean and StdDev of non-missing avg (divisor N-1)."
    },
    {
      "step": "s4",
      "risks": [
        "S-10"
      ],
      "text": "Attach Mean and StdDev to every row."
    },
    {
      "step": "s5",
      "risks": [
        "S-12"
      ],
      "text": "Rename avg to score_before_std. Add grp_score from s2 by PROVIDER_ID. Keep all rows."
    }
  ],
  "properties": [
    {
      "id": "p1",
      "kind": "missing_iff",
      "description": "grp_score is missing exactly where total_cnt = 0",
      "column": "grp_score",
      "when": "total_cnt == 0"
    },
    {
      "id": "p2",
      "kind": "mean_sd",
      "description": "over non-missing rows, grp_score has mean 0 and SD 1 (divisor N-1)",
      "column": "grp_score",
      "mean": 0,
      "sd": 1,
      "ddof": 1
    },
    {
      "id": "p3",
      "kind": "constant",
      "description": "Mean and StdDev are constant across rows",
      "columns": [
        "Mean",
        "StdDev"
      ]
    },
    {
      "id": "p4",
      "kind": "equals",
      "description": "grp_score = (score_before_std - Mean) / StdDev",
      "left": "grp_score",
      "right": "(score_before_std - Mean) / StdDev"
    },
    {
      "id": "p5",
      "kind": "equals",
      "description": "measure_wt x total_cnt = 1 where total_cnt > 0",
      "left": "measure_wt * total_cnt",
      "right": "1",
      "where": "total_cnt > 0"
    }
  ],

# Template for the SAS agent's local secrets.
# Copy this file to `.env` in the repository root and fill in your values:
#
#   cp .env_template .env
#
# `.env` is listed in .gitignore. Never commit a real key, and never put one in this template.
# sas_agent/config.py loads `.env` automatically; variables already set in the environment
# (e.g. a Codespaces secret) take precedence over the file.

# Gemini Developer API key (required). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Optional: override the chat model (any LangChain `init_chat_model` string).
# Model codes: https://ai.google.dev/gemini-api/docs/models
# SAS_AGENT_MODEL=google_genai:gemini-3.8-flash

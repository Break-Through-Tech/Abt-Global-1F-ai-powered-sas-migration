    "Property": {
      "description": "A claim about an output that code can test on SAS's own results.\n\nkind and the fields it needs:\n- missing_iff: column, when       (column is missing exactly where the expression `when` is true)\n- mean_sd:     column, mean, sd, ddof   (over non-missing values)\n- constant:    columns            (each column has one value across rows)\n- equals:      left, right, where (left equals right within tol, where `where` holds and both are non-missing)\n- in_range:    column, min, max   (non-missing values lie in [min, max])",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "missing_iff",
            "mean_sd",
            "constant",
            "equals",
            "in_range"
          ],
